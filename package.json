{
    "name": "@polyester/sdk",
    "version": "0.4.3",
    "private": false,
    "description": "TypeScript SDK providing access to APIs on Polyester Exchange.",
    "homepage": "https://github.com/Fabric-Labs/polyester-sdk-typescript#readme",
    "bugs": {
        "url": "https://github.com/Fabric-Labs/polyester-sdk-typescript/issues"
    },
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Fabric-Labs/polyester-sdk-typescript.git"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "SECURITY.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./catalogs": {
            "types": "./dist/catalogs/index.d.ts",
            "import": "./dist/catalogs/index.js",
            "default": "./dist/catalogs/index.js"
        },
        "./smart-account": {
            "types": "./dist/smart-account/index.d.ts",
            "import": "./dist/smart-account/index.js",
            "default": "./dist/smart-account/index.js"
        },
        "./server-session": {
            "types": "./dist/server-session.d.ts",
            "import": "./dist/server-session.js",
            "default": "./dist/server-session.js"
        },
        "./account-signer": {
            "types": "./dist/account-signer/index.d.ts",
            "import": "./dist/account-signer/index.js",
            "default": "./dist/account-signer/index.js"
        },
        "./unstable/gen": {
            "types": "./dist/gen/index.d.ts",
            "import": "./dist/gen/index.js",
            "default": "./dist/gen/index.js"
        },
        "./unstable/gen/*": {
            "types": "./dist/gen/*.d.ts",
            "import": "./dist/gen/*.js",
            "default": "./dist/gen/*.js"
        },
        "./unstable/wired-services": {
            "types": "./dist/wired-services.d.ts",
            "import": "./dist/wired-services.js",
            "default": "./dist/wired-services.js"
        },
        "./errors": {
            "types": "./dist/shared/errors.d.ts",
            "import": "./dist/shared/errors.js",
            "default": "./dist/shared/errors.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "bun --bun tsdown",
        "prepack": "bun run build",
        "dev": "bun --bun tsdown --watch --log-level error",
        "check": "bun run check:src && bun run check:scripts",
        "check:src": "tsc -p tsconfig.json --noEmit",
        "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
        "test": "bun --bun vitest run",
        "format": "bun --bun oxfmt \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
        "format:check": "bun --bun oxfmt --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
        "lint": "bun --bun oxlint",
        "lint:fix": "bun --bun oxlint --fix",
        "changeset": "changeset",
        "version-packages": "changeset version && bun install --lockfile-only",
        "release": "changeset publish",
        "verify:package": "bun run build && bun scripts/verify-package-exports.ts",
        "ci": "bun run lint && bun run format:check && bun run check && bun run test && bun run verify:package"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.13.0",
        "@connectrpc/connect": "2.1.2",
        "@connectrpc/connect-web": "2.1.2",
        "@noble/ed25519": "3.1.0",
        "@noble/hashes": "2.2.0",
        "centrifuge": "5.7.0",
        "permissionless": "0.3.7",
        "valibot": "1.4.2",
        "viem": "2.55.10"
    },
    "devDependencies": {
        "@changesets/changelog-github": "0.7.0",
        "@changesets/cli": "2.31.1",
        "@types/bun": "1.3.14",
        "oxfmt": "0.61.0",
        "oxlint": "1.76.0",
        "tsdown": "0.22.14",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "packageManager": "bun@1.3.11"
}
