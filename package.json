{
  "name": "@fabric-labs/polyester-sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK providing access to APIs on Polyester Exchange.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "packageManager": "bun@1.3.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fabric-Labs/polyester-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Fabric-Labs/polyester-sdk-typescript/issues"
  },
  "homepage": "https://github.com/Fabric-Labs/polyester-sdk-typescript#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "import": "./dist/gen/*.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --bun tsdown --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "changeset": "bun --bun node_modules/.bin/changeset",
    "ci:publish": "bun run build && bun --bun node_modules/.bin/changeset publish",
    "format": "bun --bun oxfmt \"src/**/*.ts\" \"*.ts\"",
    "format:check": "bun --bun oxfmt --check \"src/**/*.ts\" \"*.ts\"",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "version": "bun --bun node_modules/.bin/changeset version",
    "hooks:install": "husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@connectrpc/connect": "2.0.3",
    "@connectrpc/connect-web": "2.0.3",
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "centrifuge": "5.5.3",
    "permissionless": "0.3.5",
    "valibot": "1.4.1",
    "viem": "2.48.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@svitejs/changesets-changelog-github-compact": "1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.0",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxfmt --write"
    ]
  }
}
